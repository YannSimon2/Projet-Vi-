def Q(Y_CH4,Y_O2,T):
    return A*rho**3*Y_CH4*Y_O2**2*np.exp(-Ta/T)/(WCH4*WO2**2)

def omega_pt_CH4(Q):
    return -WCH4*Q
def omega_pt_O2(Q):
    return -2*WO2*Q
def omega_pt_CO2(Q):
    return WCO2*Q
def omega_pt_H2O(Q):
    return 2*WH2O*Q

def omega_pt_T(omega_pt_k):
    return (-deltahCH4*omega_pt_k[0]/WCH4 - deltahO2*omega_pt_k[1]/WO2 + deltahCO2*omega_pt_k[2]/WCO2 + deltahH2O*omega_pt_k[3]/WH2O)
t0 = 0
