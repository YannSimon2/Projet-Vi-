# Species transport using advection-diffusion equation
# Species: N2, O2, CH4, H2O, CO2

@jit(nopython=True)
def iterate_species(Y, n, U_field, dx, dy, dt, D):
    """
    Solve species transport equation: dY/dt + u*dY/dx + v*dY/dy = D*(d2Y/dx2 + d2Y/dy2)
    Using upwind scheme for advection and central differences for diffusion
    """
    Nx, Ny = Y.shape[1], Y.shape[2]
    
    for i in range(1, Nx-1):
        for j in range(1, Ny-1):
            u = U_field[i, j, 0]
            v = U_field[i, j, 1]
            
            # Upwind scheme for advection
            if u > 0:
                dYdx = (Y[n,i,j] - Y[n,i-1,j]) / dx
            else:
                dYdx = (Y[n,i+1,j] - Y[n,i,j]) / dx
            
            if v > 0:
                dYdy = (Y[n,i,j] - Y[n,i,j-1]) / dy
            else:
                dYdy = (Y[n,i,j+1] - Y[n,i,j]) / dy
            
            # Advection terms
            advection = -u*dYdx - v*dYdy
            
            # Diffusion terms (central difference)
            d2Ydx2 = (Y[n,i+1,j] - 2*Y[n,i,j] + Y[n,i-1,j]) / (dx*dx)
            d2Ydy2 = (Y[n,i,j+1] - 2*Y[n,i,j] + Y[n,i,j-1]) / (dy*dy)
            diffusion = D * (d2Ydx2 + d2Ydy2)
            
            Y[n+1,i,j] = Y[n,i,j] + dt * (advection + diffusion)
    
    return Y

